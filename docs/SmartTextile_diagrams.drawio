<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" version="24.0.0"><diagram id="page-flow" name="Process flow"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="800" math="0" shadow="0"><root><mxCell id="c0" /><mxCell id="c1" parent="c0" /><mxCell id="c2" value="&lt;b style=&quot;font-size:20px&quot;&gt;Smart Textile Manufacturing - process flow &lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#1f2937;" vertex="1" parent="c1"><mxGeometry x="40" y="20" width="1100" height="30" as="geometry" /></mxCell><mxCell id="c3" value="Raw material to packaged product. Y = PLC outputs, X = PLC inputs. Main process times (belt 3 s, cut 3 s, finish 5 or 8 s, sort 3 s) are the same in the PLC, the HMI and the 3D cell." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#6b7280;" vertex="1" parent="c1"><mxGeometry x="40" y="52" width="1100" height="24" as="geometry" /></mxCell><mxCell id="c4" value="&lt;b&gt;1  Raw material&lt;/b&gt;&lt;br&gt;Cloth sheets A and B&lt;br&gt;(every 3rd one is type B)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;arcSize=8;" vertex="1" parent="c1"><mxGeometry x="40" y="130" width="160" height="100" as="geometry" /></mxCell><mxCell id="c5" value="&lt;b&gt;2  Feeding&lt;/b&gt;&lt;br&gt;Y0 feeder, Y1 belt&lt;br&gt;ID sensor X3 / X4 / X5&lt;br&gt;belt travel 3 s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=8;" vertex="1" parent="c1"><mxGeometry x="240" y="130" width="160" height="100" as="geometry" /></mxCell><mxCell id="c6" value="&lt;b&gt;3  Processing 1&lt;/b&gt;&lt;br&gt;Cutting, Y2&lt;br&gt;3 s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=8;" vertex="1" parent="c1"><mxGeometry x="440" y="130" width="160" height="100" as="geometry" /></mxCell><mxCell id="c7" value="&lt;b&gt;4  Processing 2&lt;/b&gt;&lt;br&gt;Finishing press, Y3&lt;br&gt;A: 5 s    B: 8 s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=8;" vertex="1" parent="c1"><mxGeometry x="640" y="130" width="160" height="100" as="geometry" /></mxCell><mxCell id="c8" value="&lt;b&gt;5  Inspection&lt;/b&gt;&lt;br&gt;Camera trigger Y4&lt;br&gt;OpenCV looks for stains&lt;br&gt;result X11 / X12" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=8;" vertex="1" parent="c1"><mxGeometry x="840" y="130" width="160" height="100" as="geometry" /></mxCell><mxCell id="c9" value="&lt;b&gt;Defect&lt;br&gt;detected?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="c1"><mxGeometry x="1040" y="130" width="150" height="100" as="geometry" /></mxCell><mxCell id="c10" value="&lt;b&gt;7a  Reject bin&lt;/b&gt;&lt;br&gt;Y7 destination: reject&lt;br&gt;stacks of 6, then emptied" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;arcSize=8;" vertex="1" parent="c1"><mxGeometry x="1260" y="130" width="160" height="100" as="geometry" /></mxCell><mxCell id="c11" value="&lt;b&gt;7b  Good bin&lt;/b&gt;&lt;br&gt;Y6 destination: good&lt;br&gt;robot sorts (3 s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=8;" vertex="1" parent="c1"><mxGeometry x="1040" y="350" width="150" height="100" as="geometry" /></mxCell><mxCell id="c12" value="&lt;b&gt;8  Packaging&lt;/b&gt;&lt;br&gt;Y10 packaging machine&lt;br&gt;robot stacks 4 per box&lt;br&gt;X15 packaged" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=8;" vertex="1" parent="c1"><mxGeometry x="840" y="350" width="160" height="100" as="geometry" /></mxCell><mxCell id="c13" value="&lt;b&gt;Box shipped&lt;/b&gt;&lt;br&gt;counted in PACKAGED&lt;br&gt;and BOXES" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=8;" vertex="1" parent="c1"><mxGeometry x="640" y="350" width="160" height="100" as="geometry" /></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="c1" source="c4" target="c5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="c1" source="c5" target="c6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="c1" source="c6" target="c7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="c1" source="c7" target="c8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="c1" source="c8" target="c9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c19" value="YES  (defect)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="c1" source="c9" target="c10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c20" value="NO  (good)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#82b366;fontColor=#2d6a2d;" edge="1" parent="c1" source="c9" target="c11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="c1" source="c11" target="c12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="c1" source="c12" target="c13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c23" value="&lt;b&gt;Robot (ABB IRB140 in CoppeliaSim)&lt;/b&gt; carries the sheet: pick from belt, to cutter, to press, to camera station, to the bin, then good sheets into the packaging box. Controller states 0 to 9, with a timeout fallback so it never gets stuck." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;arcSize=8;dashed=1;align=left;spacingLeft=8;" vertex="1" parent="c1"><mxGeometry x="40" y="260" width="960" height="70" as="geometry" /></mxCell><mxCell id="c24" value="&lt;b&gt;KPIs (shown on the HMI, PLC registers D100 to D109)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Production rate = products per minute (D105)&lt;br&gt;Cycle (takt) time = gap between sorted products (D104)&lt;br&gt;Defect % = rejects / total (D103)&lt;br&gt;Good, Reject, Total, Packaged counts (D100 to D102, D109)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="c1"><mxGeometry x="40" y="350" width="560" height="150" as="geometry" /></mxCell><mxCell id="c25" value="&lt;b&gt;Control and safety (PLC ladder, all stations)&lt;/b&gt;&lt;br&gt;&lt;br&gt;START / STOP / RESET from the HMI buttons or field push-buttons X0 / X1 / X2. STOP always wins.&lt;br&gt;EMERGENCY STOP (HMI button or E-stop chain X17 opens) latches M2 and stops every output. RESET is accepted only when X16 (robot healthy) and X17 are OK.&lt;br&gt;Faults: robot fault or watchdog (30 s), inspection timeout (5 s), index or packaging jam (15 s), unknown product. Fault latches M1, red lamp Y13, buzzer Y11. Run lamp Y12." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#b85450;fontSize=12;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="c1"><mxGeometry x="40" y="540" width="1150" height="150" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="page-arch" name="System architecture"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="800" math="0" shadow="0"><root><mxCell id="c0" /><mxCell id="c1" parent="c0" /><mxCell id="c2" value="&lt;b style=&quot;font-size:20px&quot;&gt;Smart Textile Manufacturing - system architecture&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#1f2937;" vertex="1" parent="c1"><mxGeometry x="40" y="20" width="1100" height="30" as="geometry" /></mxCell><mxCell id="c3" value="Everything talks to the OpenPLC Runtime over Modbus TCP (port 502). The 3D cell runs in CoppeliaSim." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#6b7280;" vertex="1" parent="c1"><mxGeometry x="40" y="52" width="1100" height="24" as="geometry" /></mxCell><mxCell id="c4" value="&lt;b&gt;OpenPLC Editor v4&lt;/b&gt;&lt;br&gt;SmartTextileLadder (LD)&lt;br&gt;SmartTextileData (ST)&lt;br&gt;Clean build and upload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=8;" vertex="1" parent="c1"><mxGeometry x="40" y="110" width="230" height="90" as="geometry" /></mxCell><mxCell id="c5" value="&lt;b&gt;OpenPLC Runtime v4&lt;/b&gt;&lt;br&gt;Ladder program, 20 ms scan&lt;br&gt;Modbus TCP slave on port 502&lt;br&gt;&lt;br&gt;Inputs X, outputs Y, HMI bits M100 to M108,&lt;br&gt;status M0 / M1 / M2, KPI registers D100 to D109" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=8;" vertex="1" parent="c1"><mxGeometry x="380" y="110" width="280" height="150" as="geometry" /></mxCell><mxCell id="c6" value="&lt;b&gt;HMI + virtual plant&lt;/b&gt;&lt;br&gt;textile_hmi.py, browser at 127.0.0.1:3000&lt;br&gt;Start / Stop / Reset / E-stop buttons&lt;br&gt;fault injection, KPIs, live schematic&lt;br&gt;plant_sim.py feeds the sensors X" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=8;" vertex="1" parent="c1"><mxGeometry x="40" y="330" width="270" height="160" as="geometry" /></mxCell><mxCell id="c7" value="&lt;b&gt;coppelia_plc_bridge.py&lt;/b&gt;&lt;br&gt;reads M0 / M1 / M2 and sets the signal PlcRun" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=8;" vertex="1" parent="c1"><mxGeometry x="760" y="110" width="240" height="80" as="geometry" /></mxCell><mxCell id="c8" value="&lt;b&gt;CoppeliaSim&lt;/b&gt;&lt;br&gt;IRB140 pick-and-place cell&lt;br&gt;robot_controller_v2.lua, states 0 to 9&lt;br&gt;holds the whole cell when PlcRun = 0&lt;br&gt;SPEED_FACTOR sets the speed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;arcSize=8;" vertex="1" parent="c1"><mxGeometry x="1100" y="110" width="300" height="150" as="geometry" /></mxCell><mxCell id="c9" value="&lt;b&gt;OpenCV vision script&lt;/b&gt;&lt;br&gt;reads the camera image, writes the signal InspectionResult (defect / good)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=8;" vertex="1" parent="c1"><mxGeometry x="1100" y="320" width="300" height="90" as="geometry" /></mxCell><mxCell id="c11" value="&lt;b&gt;Modbus map&lt;/b&gt;&lt;br&gt;&lt;br&gt;Outputs Y0 to Y13 (feeder, belt, cutter, press, camera, robot, bins, packaging, lamps) = coils 0 to 11&lt;br&gt;HMI buttons M100 to M108 (start, stop, reset, auto, manual, A, B, clear, E-stop) = coils 800 to 808&lt;br&gt;Field inputs X0 to X17, X20 (sensors, push-buttons, E-stop chain) = coils 816 to 832&lt;br&gt;Status M0 run, M1 fault, M2 E-stop = coils 840, 841, 842&lt;br&gt;KPI registers D100 to D109 = holding registers 1024 to 1033" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="c1"><mxGeometry x="700" y="440" width="700" height="200" as="geometry" /></mxCell><mxCell id="c12" value="upload program" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="c1" source="c4" target="c5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c13" value="writes buttons (coils 800 to 808)&lt;br&gt;and sensors X (coils 816 to 832)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="c1" source="c6" target="c5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c14" value="reads outputs Y, status, KPIs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.95;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;strokeColor=#82b366;" edge="1" parent="c1" source="c5" target="c6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c15" value="reads coils 840 to 842" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="c1" source="c5" target="c7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c16" value="signal PlcRun&lt;br&gt;(1 = run, 0 = hold)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="c1" source="c7" target="c8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c17" value="InspectionResult" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;" edge="1" parent="c1" source="c9" target="c8"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>